# Node Environment
NODE_ENV=development

# Core Engine Execution Configuration
MSE_TARGET_REPO=./test/fixtures/target_repo
MSE_OUTPUT_DIR=.mse-output
MSE_LOG_LEVEL=info

# Thermodynamic Energy & Invariant Penalties
MSE_ENERGY_LAMBDA=1.0
MSE_ENERGY_GAMMA=0.5

# Pre-Flight Security & Entropy Thresholds
MSE_SHIELD_ENABLED=true
MSE_ENTROPY_THRESHOLD=4.0
MSE_MIN_ENTROPY_LEN=20
MSE_MAX_BUFFER_MB=5

# Web Dashboard Port & Host
PORT=5173
HOST=localhost
