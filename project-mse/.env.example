# ==============================================================================
# Project MSE Web Dashboard — Environment Configuration Template (Vite)
# ==============================================================================
# Vite requires public variables to be prefixed with VITE_
# ==============================================================================

# Application Branding
VITE_APP_TITLE="Project MSE — Morphogenetic Software Engine"
VITE_APP_VERSION="1.0.0"

# Target Environment (development | production)
VITE_APP_ENV="development"

# Telemetry Bus Streaming Interval (milliseconds)
VITE_TELEMETRY_INTERVAL_MS=3000

# Optional API Backend URL (leave empty for standalone mock/client mode)
VITE_API_BASE_URL=""
